#!/usr/bin/env bash

set -euo pipefail

# Runtime overrides: DEV_SESSION_CODEX, DEV_SESSION_TERMINAL, and DEV_SESSION_TMUX.

usage() {
  cat >&2 <<'EOF'
Usage:
  dev-session [--launch] [--name NAME] [PROJECT]
  dev-session --task NAME --cwd DIRECTORY [--launch-if-detached] [--name NAME] PROJECT -- COMMAND...
EOF
}

launch_terminal=false
launch_if_detached=false
session_name=""
task_name=""
task_cwd=""
codex_command=${DEV_SESSION_CODEX:-codex}
terminal_command=${DEV_SESSION_TERMINAL:-foot}
tmux_command=${DEV_SESSION_TMUX:-tmux}

while (($#)); do
  case "$1" in
  --launch)
    launch_terminal=true
    shift
    ;;
  --launch-if-detached)
    launch_if_detached=true
    shift
    ;;
  --name)
    if (($# < 2)); then
      usage
      exit 2
    fi
    session_name=$2
    shift 2
    ;;
  --task)
    if (($# < 2)); then
      usage
      exit 2
    fi
    task_name=$2
    shift 2
    ;;
  --cwd)
    if (($# < 2)); then
      usage
      exit 2
    fi
    task_cwd=$2
    shift 2
    ;;
  --help|-h)
    usage
    exit 0
    ;;
  --)
    shift
    break
    ;;
  -*)
    echo "Unknown option: $1" >&2
    usage
    exit 2
    ;;
  *)
    break
    ;;
  esac
done

project=${1:-$PWD}
if (($#)); then
  shift
fi

task_command=()
if [[ "${1:-}" == -- ]]; then
  shift
  task_command=("$@")
elif (($#)); then
  usage
  exit 2
fi

if [[ ! -d "$project" ]]; then
  echo "Project directory does not exist: $project" >&2
  exit 1
fi

project=$(realpath -- "$project")

for command in "$tmux_command" "$codex_command"; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Missing required command: $command" >&2
    exit 1
  fi
done

if [[ -n "$task_name" ]]; then
  [[ "$task_name" =~ ^[[:alnum:]_.-]+$ ]] || {
    echo "Invalid task window name: $task_name" >&2
    exit 1
  }
  [[ -n "$task_cwd" && -d "$task_cwd" ]] || {
    echo "Task directory does not exist: $task_cwd" >&2
    exit 1
  }
  ((${#task_command[@]})) || {
    echo "A task command is required after --." >&2
    exit 2
  }
  task_cwd=$(realpath -- "$task_cwd")
elif [[ -n "$task_cwd" ]] || ((${#task_command[@]})); then
  usage
  exit 2
fi

if $launch_terminal || $launch_if_detached; then
  if ! command -v "$terminal_command" >/dev/null 2>&1; then
    echo "Missing required command: $terminal_command" >&2
    exit 1
  fi
fi

if [[ -z "$session_name" ]]; then
  project_name=$(basename -- "$project")
  project_name=${project_name//[^[:alnum:]_.-]/-}
  session_name="dev-${project_name}"
fi

if [[ ! "$session_name" =~ ^[[:alnum:]_.-]+$ ]]; then
  echo "Invalid session name: $session_name" >&2
  exit 1
fi

if "$tmux_command" has-session -t "=$session_name" 2>/dev/null; then
  session_root=$("$tmux_command" show-options -t "=$session_name" -qv @project-root)
  if [[ "$session_root" != "$project" ]]; then
    echo "Session $session_name belongs to ${session_root:-an unknown project}." >&2
    echo "Use --name to choose a distinct session name." >&2
    exit 1
  fi
else
  "$tmux_command" new-session -d -s "$session_name" -n shell -c "$project"
  "$tmux_command" set-option -t "=$session_name" @project-root "$project" >/dev/null
fi

if ! "$tmux_command" list-windows -t "=$session_name" -F '#{window_name}' | grep -Fxq agent; then
  "$tmux_command" new-window -d -t "=$session_name" -n agent -c "$project" "$codex_command"
fi

selected_window=agent
if [[ -n "$task_name" ]]; then
  if "$tmux_command" list-windows -t "=$session_name" -F '#{window_name}' | grep -Fxq "$task_name"; then
    echo "Task window already exists: $task_name" >&2
    exit 1
  fi

  printf -v task_shell '%q ' "${task_command[@]}"
  task_window_id=$("$tmux_command" new-window -d -P -F '#{window_id}' \
    -t "=$session_name" -n "$task_name" -c "$task_cwd" "$task_shell")
  "$tmux_command" set-window-option -t "$task_window_id" automatic-rename off >/dev/null
  selected_window=$task_window_id
fi
"$tmux_command" select-window -t "$selected_window"

if $launch_if_detached && ! "$tmux_command" list-clients -t "=$session_name" >/dev/null 2>&1; then
  launch_terminal=true
fi

if $launch_terminal; then
  "$terminal_command" --app-id=dev.vals.DevSession --working-directory="$project" \
    tmux attach-session -t "=$session_name" \
    >/dev/null 2>&1 &
elif [[ -n "$task_name" ]]; then
  exit 0
elif [[ -n "${TMUX:-}" ]]; then
  exec "$tmux_command" switch-client -t "=$session_name"
else
  exec "$tmux_command" attach-session -t "=$session_name"
fi
